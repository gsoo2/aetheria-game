{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "aetheria-rpg",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {"directory": "../dist/external/client", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"]},
  "durable_objects": {"bindings": [{"name": "REALM", "class_name": "AetheriaRealm"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["AetheriaRealm"]}]
}
